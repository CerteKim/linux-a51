// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi Book S 12.4 (SC8180XP) — overclocked GPU variant.
 *
 * The part on this board is binned higher than the profile Linux describes by
 * default: the firmware's own ACPI tables carry several GPU DVFS sets under
 * "ENGINE_PSTATE_SET" 0x02 / "GRAPHICS_FREQ_CONTROL" / "CORE_CLOCK", and the
 * one used here is the 670 MHz profile (the standard, stock profile that
 * sc8180x.dtsi describes tops out at 514 MHz):
 *
 *     PSTATE  CORE_CLOCK  GPU%  RPMh level
 *     0       670 MHz     100%  TURBO_L1 (0x1a0)
 *     1       625 MHz      93%  TURBO    (0x180)
 *     2       595 MHz      89%  NOM_L1   (0x140)
 *     3       530 MHz      79%  NOM      (0x100)
 *     4       392 MHz      59%  SVS_L1   (0x0c0)
 *     5       315 MHz      47%  SVS      (0x080)
 *     6       235 MHz      35%  LOW_SVS  (0x040)
 *
 * Only the states missing from the stock table are added here (530/595/670),
 * so the stock low-power points stay available.  Adding them is all that is
 * needed: the a6xx driver hands its entire OPP table to the GMU over HFI
 * (a6xx_hfi_send_perf_table — "num_gpu_levels = gmu->nr_gpu_freqs"), so these
 * become real firmware DVFS levels, and each level's GX rail arc vote is
 * derived from opp-level (a6xx_gmu_rpmh_arc_votes_init ->
 * a6xx_gmu_get_arc_level -> dev_pm_opp_get_level).
 *
 * The remaining states of that vendor profile (625 MHz @ TURBO and, in the
 * even higher 718 MHz profile, 718 MHz @ TURBO_L2) are deliberately not added.
 */

/dts-v1/;

#include "sc8180x-xiaomi-book-12.4.dtsi"

&gpu_opp_table {
	opp-530000000 {
		opp-hz = /bits/ 64 <530000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
	};

	opp-595000000 {
		opp-hz = /bits/ 64 <595000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
	};

	opp-670000000 {
		opp-hz = /bits/ 64 <670000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_TURBO_L1>;
	};
};
